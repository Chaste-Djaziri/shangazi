{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "nextjs"
    },
    "studio-shangazi": {
      "root": "studio-shangazi",
      "framework": "sanity",
      "buildCommand": "npm run build",
      "outputDirectory": "dist"
    }
  },
  "redirects": [
    {
      "source": "/studio",
      "destination": "/studio/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/studio/(.*)",
      "destination": {
        "service": "studio-shangazi"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
